#
# Loops whose do script breaks, for the break tests. Each do script
# counts its passes and how many get past the break. A test sets the
# pass to break on: skip_on for a plain break, which skips the rest of
# that pass (4 passes, 3 after), or end_on for break loop, which ends
# the loop (2 passes, 1 after).
#
bl [can] :
  passes [int] : 0
  after [int] : 0
  log [string] :

  # The pass to break on; 0 never breaks.
  skip_on [int] : 0
  end_on [int] : 0

  rep [repeat] :
    times [int] : 4
    index [int] :
    do [script] :
      put bl.passes + 1 into bl.passes
      if bl.passes = bl.skip_on then break
      if bl.passes = bl.end_on then break loop
      put bl.after + 1 into bl.after

  kids [can] :
    a [string] : a
    b [string] : b
    c [string] : c
    d [string] : d

  each_child [each] :
    child [alias] :
    in [alias] : bl.kids
    do [script] :
      put bl.passes + 1 into bl.passes
      if bl.passes = bl.skip_on then break
      if bl.passes = bl.end_on then break loop
      put bl.after + 1 into bl.after

  words [string] : one two three four

  each_word [each] :
    word [string] :
    in [alias] : bl.words
    do [script] :
      put bl.passes + 1 into bl.passes
      if bl.passes = bl.skip_on then break
      if bl.passes = bl.end_on then break loop
      put bl.after + 1 into bl.after

  lines [text] : BEGIN
one
two
three
four
END

  each_line [each] :
    line [string] :
    in [alias] : bl.lines
    do [script] :
      put bl.passes + 1 into bl.passes
      if bl.passes = bl.skip_on then break
      if bl.passes = bl.end_on then break loop
      put bl.after + 1 into bl.after

  # The tests put a folder path into in.
  each_file [each] :
    file [file] :
    in [file] :
    do [script] :
      put bl.passes + 1 into bl.passes
      if bl.passes = bl.skip_on then break
      if bl.passes = bl.end_on then break loop
      put bl.after + 1 into bl.after

  each_dir [each] :
    dir [file] :
    in [file] :
    do [script] :
      put bl.passes + 1 into bl.passes
      if bl.passes = bl.skip_on then break
      if bl.passes = bl.end_on then break loop
      put bl.after + 1 into bl.after

  # The script that runs a loop carries on after break loop ends it.
  runner [script] :
    put 2 into bl.end_on
    tell bl.rep to run
    put 'went on' into bl.log

  # break loop in the inner loop ends only the inner loop.
  outer [repeat] :
    times [int] : 3
    index [int] :
    do [script] :
      put bl.passes + 1 into bl.passes
      tell bl.inner to run

  inner [repeat] :
    times [int] : 3
    index [int] :
    do [script] :
      if bl.inner.index = 1 then break loop
      put bl.after + 1 into bl.after

  # A plain break in a script the do script runs ends only that script.
  helper [script] :
    if bl.via.index = 1 then break

  via [repeat] :
    times [int] : 3
    index [int] :
    do [script] :
      put bl.passes + 1 into bl.passes
      run bl.helper
      put bl.after + 1 into bl.after

  # break loop in a script the do script runs is an error: it's only
  # valid directly in a loop's do script. The loop goes on.
  loop_helper [script] :
    if bl.via_loop.index = 1 then break loop

  via_loop [repeat] :
    times [int] : 3
    index [int] :
    do [script] :
      put bl.passes + 1 into bl.passes
      run bl.loop_helper
      put bl.after + 1 into bl.after

  # break loop outside any loop is an error.
  lone [script] :
    break loop

  # Grouped children: break loop still closes the open group.
  groups [can] :
    g1 [can] :
      kind [string] : x
    g2 [can] :
      kind [string] : x
    g3 [can] :
      kind [string] : y

  grouped [each] :
    child [alias] :
    in [alias] : bl.groups
    group_by [string] : kind
    on_group_start [script] :
      put bl.log + '<' into bl.log
    on_group_end [script] :
      put bl.log + '>' into bl.log
    do [script] :
      put bl.passes + 1 into bl.passes
      if bl.passes = 2 then break loop
      put bl.log + 'c' into bl.log

  # break loop in a group script is an error; the loop goes on.
  start_breaks [each] :
    child [alias] :
    in [alias] : bl.groups
    group_by [string] : kind
    on_group_start [script] :
      break loop
    do [script] :
      put bl.passes + 1 into bl.passes

  end_breaks [each] :
    child [alias] :
    in [alias] : bl.groups
    group_by [string] : kind
    on_group_end [script] :
      break loop
    do [script] :
      put bl.passes + 1 into bl.passes
