#
# Save verb tests -- real load -> edit -> save round trips.
#
# Each test writes a .gloo fixture to $.gloo_tmp, loads it, does something,
# saves, reads the file back, and asserts on the raw text. Every test
# unloads its object and deletes its scratch file at the end so the
# next one starts clean.
#

tests.verbs.save [can] :

  f [file] :
  g [file] :
  to_target [file] :

  # Scratch files live in the gloo tmp folder ($.gloo_tmp).
  on_load [script] :
    put $.gloo_tmp '/gloo_save_test.gloo' into ^.f
    put $.gloo_tmp '/gloo_save_test_2.gloo' into ^.g
    put $.gloo_tmp '/gloo_save_test_to.gloo' into ^.to_target

  computed_name [string] : /gloo_save_computed_to
  computed_target [file] :
  out [string] :
  err [bool] : false

  on_error [script] :
    put true into ^.err

  #
  # The fixture used by most tests: two comments, a changed-in-place
  # value, and an untouched sibling.
  #
  fixture [text] : BEGIN
#
# a comment above demo
#
demo [container] :
  msg [string] : hello
  # a comment above other
  other [string] : world
END

  #
  # Regression fixture: a blank line between a container's own
  # declaration and its first child (not between two siblings, which
  # already worked) used to land one level too shallow.
  #
  blank_before_first_child_fixture [text] : BEGIN
#
# The main app container.
#
app [can] :

  # Core settings live here.
  core [can] :

    # Some other core thing.
    other [string] : hi

  # Something unrelated at the app level.
  name [string] : My App
END

  round_trip_preserves_comments_and_untouched_lines [test] :
    description [string] : load, change one value, save -- comments and the untouched sibling survive.
    on_test [script] :
      put false into ^^.err
      tell ^^.f to write ( ^^.fixture )
      load ( ^^.f )
      put 'changed' into demo.msg
      save demo
      eval ^^.err = false
      assert "save should not error"
      tell ^^.f to read ( ^^.out )
      check ^^.out for substring? ( "# a comment above demo" )
      assert "the leading comment block should survive"
      check ^^.out for substring? ( "# a comment above other" )
      assert "the inner comment should survive"
      check ^^.out for substring? ( "msg [string] : changed" )
      assert "the changed value should be written"
      check ^^.out for substring? ( "other [string] : world" )
      assert "the untouched sibling should be unchanged"
      tell demo to unload
      tell ^^.f to delete

  unchanged_file_round_trips_byte_for_byte [test] :
    description [string] : load then save with no change reproduces the file exactly.
    on_test [script] :
      tell ^^.f to write ( ^^.fixture )
      load ( ^^.f )
      save demo
      tell ^^.f to read ( ^^.out )
      eval ^^.out = ^^.fixture
      assert "an unchanged save should reproduce the original text"
      tell demo to unload
      tell ^^.f to delete

  blank_before_first_child [test] :
    description [string] : An unchanged save reproduces blank lines before a container's first child too.
    on_test [script] :
      tell ^^.f to write ( ^^.blank_before_first_child_fixture )
      load ( ^^.f )
      save app
      tell ^^.f to read ( ^^.out )
      eval ^^.out = ^^.blank_before_first_child_fixture
      assert "an unchanged save should reproduce the original text, blank lines included"
      tell app to unload
      tell ^^.f to delete

  deleting_an_object_drops_its_line [test] :
    description [string] : removing a child and saving drops just that declaration.
    on_test [script] :
      tell ^^.f to write ( ^^.fixture )
      load ( ^^.f )
      tell demo.other to unload
      save demo
      tell ^^.f to read ( ^^.out )
      check ^^.out for substring? ( "msg [string] : hello" )
      assert "the kept sibling should still be there"
      check ^^.out for substring? ( "other [string]" )
      refute "the removed child's line should be gone"
      tell demo to unload
      tell ^^.f to delete

  save_to_a_new_path_creates_the_file [test] :
    description [string] : save {obj} to {path} writes a new file and registers it.
    on_test [script] :
      tell ^^.f to write ( ^^.fixture )
      load ( ^^.f )
      save demo to ( ^^.to_target )
      check ^^.to_target for exists?
      assert "save ... to should create the target file"
      tell ^^.to_target to read ( ^^.out )
      check ^^.out for substring? ( "msg [string] : hello" )
      assert "the new file should hold the object"
      tell demo to unload
      tell ^^.f to delete
      tell ^^.to_target to delete

  save_to_a_computed_path [test] :
    description [string] : save {obj} to ( expr ) writes the file the expression works out to.
    on_test [script] :
      tell ^^.f to write ( ^^.fixture )
      load ( ^^.f )
      save demo to ( $.gloo_tmp ^^.computed_name )
      put $.gloo_tmp ^^.computed_name '.gloo' into ^^.computed_target
      check ^^.computed_target for exists?
      assert "save ... to ( expr ) should create the computed file"
      tell ^^.computed_target to read ( ^^.out )
      check ^^.out for substring? ( "msg [string] : hello" )
      assert "the computed file should hold the object"
      tell demo to unload
      tell ^^.f to delete
      tell ^^.computed_target to delete

  extracting_a_subtree_moves_it_to_the_new_file [test] :
    description [string] : save {nested obj} to {path} moves its declaration (and its own comment) out of the old file into the new one.
    on_test [script] :
      tell ^^.f to write ( ^^.fixture )
      load ( ^^.f )
      save demo.other to ( ^^.to_target )
      check ^^.to_target for exists?
      assert "extraction should create the target file"

      tell ^^.to_target to read ( ^^.out )
      check ^^.out for substring? ( "demo.other [string] : world" )
      assert "the target file should declare the moved object under its full dotted path"
      check ^^.out for substring? ( "# a comment above other" )
      assert "the moved object's own comment should travel with it"

      tell ^^.f to read ( ^^.out )
      check ^^.out for substring? ( "other [string]" )
      refute "the old file should no longer declare the moved object"
      check ^^.out for substring? ( "msg [string] : hello" )
      assert "the old file should keep everything else"

      # a later plain save of demo must not resurrect the moved object
      save demo
      tell ^^.f to read ( ^^.out )
      check ^^.out for substring? ( "other" )
      refute "a later save of the old root should not re-add the moved object"

      tell demo.other to unload
      tell demo to unload
      tell ^^.f to delete
      tell ^^.to_target to delete

  extracting_a_subtree_spanning_multiple_files_is_an_error [test] :
    description [string] : save {obj} to {path} refuses when obj's own subtree has declarations in more than one file.
    expect_errors [bool] : true
    on_test [script] :
      put false into ^^.err
      tell ^^.f to write ( ^^.fixture )
      load ( ^^.f )
      # a second file adds its own child under the same 'demo' container --
      # a namespace pattern applied inside the subtree we'll try to extract
      tell ^^.g to write ( "demo [container] :\n  extra [string] : too\n" )
      load ( ^^.g )

      save demo to ( ^^.to_target )
      eval ^^.err = true
      assert "extraction should refuse a subtree spanning multiple files"
      check ^^.to_target for exists?
      refute "the target file should not have been created"

      tell demo to unload
      tell ^^.f to delete
      tell ^^.g to delete

  reload_discards_unsaved_changes [test] :
    description [string] : reload throws away edits that were not saved.
    expect_errors [bool] : true
    on_test [script] :
      tell ^^.f to write ( ^^.fixture )
      load ( ^^.f )
      put 'not saved' into demo.msg
      eval demo.msg = 'not saved'
      assert "sanity: the edit landed"
      tell demo to reload
      eval demo.msg = 'hello'
      assert "reload should restore the on-disk value"
      tell demo to unload
      tell ^^.f to delete

  # -------------------------------------------------------------------
  #   Lossless save (7.2): an untouched declaration is written back
  #   exactly; a changed one changes only its own line.
  # -------------------------------------------------------------------

  body_fixture [text] : BEGIN
lossless_body [can] :
  n [int] : 0
  s [script] :
    put 1 into ^.n

    # a comment inside the body
    put ^.n + 1 into ^.n  # an inline comment
    put ^.n + \
      2 into ^.n
  after [string] : after
END

  directive_fixture [text] : BEGIN
#
# A comment block above the directive.
#
load lib yaml

lossless_lib [can] :
  cfg [yaml] :
END

  untyped_fixture [text] : BEGIN
lossless_untyped [can] :
  plain : no type given
END

  untyped_changed [text] : BEGIN
lossless_untyped [can] :
  plain : changed
END

  same_name_fixture [text] : BEGIN
lossless_same [can] :
  a [string] : First A
  a [string] : Second A
END

  same_name_changed [text] : BEGIN
lossless_same [can] :
  a [string] : Changed
  a [string] : Second A
END

  shorthand_fixture [text] : BEGIN
lossless_short [can] :
  x [int] : 1

lossless_short.b [can] :
  y [int] : 2
END

  style_fixture [text] : BEGIN
lossless_style [can] :
  n [int] : 1
END

  style_changed [text] : BEGIN
lossless_style [can] :
  n [int] : 1
  k [int] : 5
END

  # A text value's fixture has its own BEGIN/END blocks, so it can't be
  # a text block here: it's a file beside this one.
  text_fixture [file] :
  text_saved [file] :
  text_src [string] :
  text_want [string] :
  where [string] :

  utf8_fixture [text] : BEGIN
# Café — ünïcödé 🎉
lossless_utf8 [can] :
  greeting [string] : héllo wörld 👋
END

  untouched_script_body_round_trips [test] :
    description [string] : blank lines, comments and a continuation in a script body survive a save.
    on_test [script] :
      tell ^^.f to write ( ^^.body_fixture )
      load ( ^^.f )
      tell lossless_body.s to run
      eval lossless_body.n = 4
      assert "sanity: the body ran, continuation and all"
      put 0 into lossless_body.n
      save lossless_body
      tell ^^.f to read ( ^^.out )
      eval ^^.out = ^^.body_fixture
      assert "expected the body exactly as written"
      tell lossless_body to unload
      tell ^^.f to delete

  directive_stays_below_its_comments [test] :
    description [string] : a load lib directive stays where it was written.
    on_test [script] :
      tell ^^.f to write ( ^^.directive_fixture )
      load ( ^^.f )
      save lossless_lib
      tell ^^.f to read ( ^^.out )
      eval ^^.out = ^^.directive_fixture
      assert "expected the directive below the comment block"
      tell lossless_lib to unload
      tell ^^.f to delete

  untyped_stays_untyped [test] :
    description [string] : an untyped declaration is saved without a type, changed or not.
    on_test [script] :
      tell ^^.f to write ( ^^.untyped_fixture )
      load ( ^^.f )
      save lossless_untyped
      tell ^^.f to read ( ^^.out )
      eval ^^.out = ^^.untyped_fixture
      assert "expected the untouched declaration exactly as written"
      put 'changed' into lossless_untyped.plain
      save lossless_untyped
      tell ^^.f to read ( ^^.out )
      eval ^^.out = ^^.untyped_changed
      assert "expected only the value to change"
      tell lossless_untyped to unload
      tell ^^.f to delete

  an_edit_changes_only_the_first_same_name_line [test] :
    description [string] : the first declaration holds the value; a later same-name line is kept as written.
    expect_errors [bool] : true
    on_test [script] :
      tell ^^.f to write ( ^^.same_name_fixture )
      load ( ^^.f )
      put 'Changed' into lossless_same.a
      save lossless_same
      tell ^^.f to read ( ^^.out )
      eval ^^.out = ^^.same_name_changed
      assert "expected Second A to stay"
      tell lossless_same to unload
      tell ^^.f to delete

  a_shorthand_child_is_written_once [test] :
    description [string] : a container plus shorthand into it saves exactly as written.
    on_test [script] :
      tell ^^.f to write ( ^^.shorthand_fixture )
      load ( ^^.f )
      save lossless_short
      tell ^^.f to read ( ^^.out )
      eval ^^.out = ^^.shorthand_fixture
      assert "expected the shorthand child not to be written again"
      tell lossless_short to unload
      tell ^^.f to delete

  a_new_child_follows_the_files_style [test] :
    description [string] : a new object is written with the file's indentation and type spelling.
    on_test [script] :
      tell ^^.f to write ( ^^.style_fixture )
      load ( ^^.f )
      create lossless_style.k as integer : 5
      save lossless_style
      tell ^^.f to read ( ^^.out )
      eval ^^.out = ^^.style_changed
      assert "expected two spaces and [int]"
      tell lossless_style to unload
      tell ^^.f to delete

  appending_to_text_does_not_indent_it [test] :
    description [string] : a changed text value is written exactly, so saving it twice adds nothing.
    on_test [script] :
      check ^^ for source_dir
      put it into ^^.where
      put ^^.where '/fixtures/lossless_text.gloo' into ^^.text_fixture
      put ^^.where '/fixtures/lossless_text_saved.gloo' into ^^.text_saved
      tell ^^.text_fixture to read ( ^^.text_src )
      tell ^^.text_saved to read ( ^^.text_want )
      tell ^^.f to write ( ^^.text_src )
      load ( ^^.f )
      put lossless_text.log + lossless_text.entry into lossless_text.log
      save lossless_text
      put lossless_text.log + lossless_text.entry into lossless_text.log
      save lossless_text
      tell ^^.f to read ( ^^.out )
      eval ^^.out = ^^.text_want
      assert "expected the lines with no added indentation"
      tell lossless_text to unload
      tell ^^.f to delete

  utf8_round_trips [test] :
    description [string] : non-ASCII text loads and saves exactly.
    on_test [script] :
      tell ^^.f to write ( ^^.utf8_fixture )
      load ( ^^.f )
      eval lossless_utf8.greeting = 'héllo wörld 👋'
      assert "expected the value as written"
      save lossless_utf8
      tell ^^.f to read ( ^^.out )
      eval ^^.out = ^^.utf8_fixture
      assert "expected the file exactly as written"
      tell lossless_utf8 to unload
      tell ^^.f to delete

