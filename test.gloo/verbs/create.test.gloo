#
# Create verb tests
#

tests.verbs.create [can] :

  create_str [test] :
    description [string] : Create sets it to the initial value.
    on_test [script] :
      create cx as string : 'hello'
      eval it = 'hello'
      assert "expected it to equal the created value"

  here_box [can] :

  create_with_a_here_path [test] :
    description [string] : create takes a ^ path inside a script, like other verbs.
    on_test [script] :
      create ^^.here_box.made as string : 'made here'
      eval tests.verbs.create.here_box.made = 'made here'
      assert "expected ^^.here_box.made to be created"

  create_with_a_one_level_here_path [test] :
    description [string] : create ^.name makes a child of the script's parent (here, the test).
    on_test [script] :
      create ^.child_of_test as int : 3
      eval tests.verbs.create.create_with_a_one_level_here_path.child_of_test = 3
      assert "expected ^.child_of_test under the test"

  create_with_a_context_path [test] :
    description [string] : create takes an @ path, relative to the context.
    on_test [script] :
      context tests.verbs.create.here_box
      create @.via_context as int : 5
      context root
      eval tests.verbs.create.here_box.via_context = 5
      assert "expected @.via_context to be created in the context"

tests.verbs.create_names [can] :

  list [can] :
  n [int] : 3
  slot [alias] :

  parenthesised_name_computes_the_name [test] :
    description [string] : create ( expr ) creates the object at the path the expression works out to.
    on_test [script] :
      create ( 'tests.verbs.create_names.list.p' ^^.n ) as string : made
      eval tests.verbs.create_names.list.p3 = 'made'
      assert "expected the object to be created at the computed path"
      tell tests.verbs.create_names.list.p3 to unload

  alias_computes_the_name [test] :
    description [string] : The way to create at a computed path: point an alias at it, then create the alias.
    on_test [script] :
      put 'tests.verbs.create_names.list.' + ^^.n into ^^.slot*
      create ^^.slot* as string
      exists? instance tests.verbs.create_names.list.3
      assert "expected the object to be created at the computed path"
