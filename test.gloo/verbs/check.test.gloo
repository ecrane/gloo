#
# Check verb tests
#

tests.verbs.check [can] :

  c [container] : has a value
    a [string] : "a"
  t [container] :
  # Children but no simple value: blank? looks at the value only.
  kids [container] :
    a [string] : "a"

  check_contains [test] :
    description [string] : Check an object for containment
    on_test [script] :
      check ^^.c for contains?
      assert "expected c to contain a"

      check ^^.t for contains?
      refute "expected t to not contain a"

      check ^^.c.a for contains?
      refute "expected a to not be a container"

  check_blank [test] :
    description [string] : Check an object for blankness
    on_test [script] :
      check ^^.c for blank?
      refute "expected c to not be blank"

      check ^^.t for blank?
      assert "expected t to be blank"

      check ^^.c.a for blank?
      refute "expected a to not be blank"

  blank_ignores_children [test] :
    description [string] : blank? asks about the simple value only; contains? asks about children
    on_test [script] :
      check ^^.kids for blank?
      assert "expected kids to be blank: it has children but no simple value"
