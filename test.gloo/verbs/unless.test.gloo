#
# Unless verb tests
#

tests.verbs.unless [can] :

  b [bool] : false

  unless_false [test] :
    description [string] : Unless false, do block runs.
    on_test [script] :
      unless ^^.b do eval true
      assert "expected do block to run when condition is false"

  unless_true [test] :
    description [string] : Unless true, do block is skipped.
    on_test [script] :
      eval false
      unless true do eval true
      refute "expected do block to be skipped when condition is true"

  unless_then [test] :
    description [string] : 'then' is a synonym for 'do'
    on_test [script] :
      eval false
      unless ^^.b then eval true
      assert "expected 'then' to work the same as 'do'"

  unless_do_else [test] :
    description [string] : else runs when the condition is true
    on_test [script] :
      eval false
      unless true do eval false else eval true
      assert "expected else to run when the condition is true"

  unless_then_else [test] :
    description [string] : else works the same with the 'then' synonym
    on_test [script] :
      eval false
      unless true then eval false else eval true
      assert "expected else to run after a 'then' action"

  #
  # unless is the exact opposite of if: the [bool] rule decides.
  #
  s [string] :
  ran [string] :

  blank_runs_do [test] :
    description [string] : A blank value is false, so the do block runs.
    on_test [script] :
      put '' into ^^.s
      unless ^^.s do put 'do' into ^^.ran else put 'else' into ^^.ran
      eval ^^.ran = 'do'
      assert "expected blank to run the do block"

  other_text_runs_do [test] :
    description [string] : Text that is neither true nor false is false, with a warning, so do runs.
    expect_errors [bool] : true
    on_test [script] :
      put 'abc' into ^^.s
      unless ^^.s do put 'do' into ^^.ran else put 'else' into ^^.ran
      eval ^^.ran = 'do'
      assert "expected other text to run the do block"

  the_text_true_runs_else [test] :
    description [string] : The text 'true' counts as true, so else runs.
    on_test [script] :
      put 'true' into ^^.s
      unless ^^.s do put 'do' into ^^.ran else put 'else' into ^^.ran
      eval ^^.ran = 'else'
      assert "expected the text true to run else"

  failed_condition_runs_neither [test] :
    description [string] : A condition that reports an error abandons the line; else doesn't run.
    expect_errors [bool] : true
    on_test [script] :
      put '' into ^^.ran
      unless no.such.obj do put 'do' into ^^.ran else put 'else' into ^^.ran
      eval ^^.ran = ''
      assert "expected neither branch to run"
