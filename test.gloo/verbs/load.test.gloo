#
# Load verb tests
#
# Mostly uses 'load lib' because it is self-contained (no fixture files) and
# its effect is observable through 'exists?'. The no-objects and
# computed-path tests write scratch files to $.gloo_tmp.
#

tests.verbs.load [can] :

  f [file] :

  # Scratch files live in the gloo tmp folder ($.gloo_tmp).
  on_load [script] :
    put $.gloo_tmp '/gloo_load_no_objects_test.gloo' into ^.f
    put $.gloo_tmp ^.wild_name into ^.wild_dir
    put ^.wild_dir '/wild_a.gloo' into ^.wild_a
    put ^.wild_dir '/wild_b.gloo' into ^.wild_b

  comments_only [text] : BEGIN
# This file has comments,

# but no objects.
END
  load_lib_only [text] : BEGIN
load lib md
# and nothing else
END

  computed_name [string] : /gloo_load_computed_test.gloo
  lib_name [string] : md
  wild_name [string] : /gloo_load_wild_test
  wild_dir [file] :
  wild_a [file] :
  wild_b [file] :
  computed_f [file] :
  computed_fixture [text] : BEGIN
computed_demo [can] :
  s [string] : hi
END

  err_fired [bool] : false
  on_error [script] :
    put true into ^.err_fired

  load_lib_registers_type [test] :
    description [string] : load lib registers that library's object types.
    on_test [script] :
      # TODO: once we fix the reset_state we can uncomment this part
      # exists? object markdown
      # refute "markdown type should not be registered before load"

      load lib md
      exists? object markdown
      assert "expected the markdown type to be registered after 'load lib md'"

  load_no_args_errors [test] :
    description [string] : load with no arguments fires on_error.
    expect_errors [bool] : true
    on_test [script] :
      put false into ^^.err_fired
      load
      eval ^^.err_fired = true
      assert "expected 'load' with no arguments to fire on_error"

  load_missing_file_errors [test] :
    description [string] : load of a file that can't be found fires on_error.
    expect_errors [bool] : true
    on_test [script] :
      put false into ^^.err_fired
      load no_such_file_xyz
      eval ^^.err_fired = true
      assert "expected 'load' of a missing file to fire on_error"

  load_comments_only_file_does_not_error [test] :
    description [string] : a file with only comments loads with a warning, not an error.
    expect_errors [bool] : true
    on_test [script] :
      put false into ^^.err_fired
      tell ^^.f to write ( ^^.comments_only )
      load ( ^^.f )
      tell ^^.f to delete
      eval ^^.err_fired = false
      assert "expected a comments-only file not to fire on_error"

  load_empty_file_does_not_error [test] :
    description [string] : an empty file loads with a warning, not an error.
    expect_errors [bool] : true
    on_test [script] :
      put false into ^^.err_fired
      tell ^^.f to write ( '' )
      load ( ^^.f )
      tell ^^.f to delete
      eval ^^.err_fired = false
      assert "expected an empty file not to fire on_error"

  load_lib_only_file_does_not_error [test] :
    description [string] : a file with only a load lib line loads with a warning, not an error.
    expect_errors [bool] : true
    on_test [script] :
      put false into ^^.err_fired
      tell ^^.f to write ( ^^.load_lib_only )
      load ( ^^.f )
      tell ^^.f to delete
      eval ^^.err_fired = false
      assert "expected a file with only 'load lib' not to fire on_error"

  load_a_computed_path [test] :
    description [string] : load ( expr ) loads the file the expression works out to.
    on_test [script] :
      put $.gloo_tmp ^^.computed_name into ^^.computed_f
      tell ^^.computed_f to write ( ^^.computed_fixture )
      load ( $.gloo_tmp ^^.computed_name )
      eval computed_demo.s = 'hi'
      assert "expected load ( expr ) to load the computed path"
      tell computed_demo to unload
      tell ^^.computed_f to delete

  load_a_path_held_in_a_file_object [test] :
    description [string] : load ( {file obj} ) loads the path the object holds.
    on_test [script] :
      put $.gloo_tmp ^^.computed_name into ^^.computed_f
      tell ^^.computed_f to write ( ^^.computed_fixture )
      load ( ^^.computed_f )
      eval computed_demo.s = 'hi'
      assert "expected load ( {file obj} ) to load the path it holds"
      tell computed_demo to unload
      tell ^^.computed_f to delete

  load_a_computed_path_from_an_unknown_object_errors [test] :
    description [string] : load ( expr ) with an expression that can't be worked out fires on_error.
    expect_errors [bool] : true
    on_test [script] :
      put false into ^^.err_fired
      load ( no_such_obj_xyz )
      eval ^^.err_fired = true
      assert "expected a bad expression in load ( ... ) to fire on_error"

  load_lib_with_a_computed_name [test] :
    description [string] : load lib ( expr ) loads the library the expression names.
    on_test [script] :
      put false into ^^.err_fired
      load lib ( ^^.lib_name )
      eval ^^.err_fired = false
      assert "expected load lib ( expr ) not to fire on_error"
      exists? object markdown
      assert "expected the markdown type to be registered"

  load_an_absolute_wildcard_path [test] :
    description [string] : load {absolute folder}/* loads every .gloo file in the folder.
    on_test [script] :
      tell ^^.wild_dir to mkdir
      tell ^^.wild_a to write ( 'wild_a [can] :' )
      tell ^^.wild_b to write ( 'wild_b [can] :' )
      load ( ^^.wild_dir '/*' )
      exists? wild_a
      assert "expected wild_a.gloo to be loaded"
      exists? wild_b
      assert "expected wild_b.gloo to be loaded"
      tell wild_a to unload
      tell wild_b to unload
      tell ^^.wild_a to delete
      tell ^^.wild_b to delete

  load_a_full_path_without_the_extension [test] :
    description [string] : load of a full path finds the .gloo file without the extension being given.
    on_test [script] :
      put $.gloo_tmp ^^.computed_name into ^^.computed_f
      tell ^^.computed_f to write ( ^^.computed_fixture )
      load ( $.gloo_tmp '/gloo_load_computed_test' )
      eval computed_demo.s = 'hi'
      assert "expected the full path without .gloo to load"
      tell computed_demo to unload
      tell ^^.computed_f to delete
