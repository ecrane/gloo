#
# Eval verb tests
#

tests.verbs.eval [can] :

  eval_expr [test] :
    description [string] : Evaluate an expression.
    on_test [script] :
      eval 1 + 1 = 2
      assert "expected 1 + 1 to equal 2"

      eval true
      assert "expected true to be true"

      eval false
      refute "expected false to be false"

  failed_expression_puts_false_in_it [test] :
    description [string] : eval of an expression that fails puts false in it.
    expect_errors [bool] : true
    on_test [script] :
      eval 1 + no_such_obj_xyz
      eval it = false
      assert "expected it to be false after a failed expression"
