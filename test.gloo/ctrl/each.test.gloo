#
# Each and repeat control object tests
#

tests.ctrl.each [can] :

  count [int] : 0

  wrd [each] :
    word [string] :
    IN [string] : one two three
    do [script] :
      eval ^^.count + 1
      put it into ^^.count

  rpt [repeat] :
    times [int] : 3
    index [int] : 0
    do [script] :
      eval ^^.count + 1
      put it into ^^.count

  each_word [test] :
    description [string] : Count words with each word
    on_test [script] :
      put 0 into ^^.count
      tell ^^.wrd to run
      eval ^^.count = 3
      assert "expected 3 words counted"

  repeat_n_times [test] :
    description [string] : Repeat a script n times
    on_test [script] :
      put 0 into ^^.count
      tell ^^.rpt to run
      eval ^^.count = 3
      assert "expected repeat to run 3 times"

#
# Each file / each dir over a nested folder tree.
# The tree is built in $.gloo_tmp and removed at the end. It's built
# and removed with shell commands, so these tests need a Unix shell.
#

tests.ctrl.each_folder [can] :

  count [int] : 0
  walk_name [string] : /gloo_each_walk
  walk [string] :

  make_tree [system] :
    command [string] :
    get_output [bool] : false
  remove_tree [system] :
    command [string] :
    get_output [bool] : false

  # The tree lives in the gloo tmp folder ($.gloo_tmp); paths are
  # quoted in the commands in case that folder has spaces.
  on_load [script] :
    put $.gloo_tmp ^.walk_name into ^.walk
    put "rm -rf '" ^.walk "' && mkdir -p '" ^.walk "/a/deep' '" ^.walk "/.obs' && cd '" ^.walk "' && touch top.md notes.txt a/x.md a/deep/Y.MD .obs/o.md" into ^.make_tree.command
    put "rm -rf '" ^.walk "'" into ^.remove_tree.command
    put ^.walk into ^.files.in
    put ^.walk '/**/' into ^.wild.in
    put ^.walk into ^.top.in
    put ^.walk into ^.dirs.in

  files [each] :
    file [file] :
    in [file] :
    ext [string] : md
    recursive [bool] : true
    do [script] :
      eval ^^.count + 1
      put it into ^^.count

  wild [each] :
    file [file] :
    in [file] :
    ext [string] : md
    do [script] :
      eval ^^.count + 1
      put it into ^^.count

  top [each] :
    file [file] :
    in [file] :
    do [script] :
      eval ^^.count + 1
      put it into ^^.count

  dirs [each] :
    dir [file] :
    in [file] :
    recursive [bool] : true
    do [script] :
      eval ^^.count + 1
      put it into ^^.count

  recursive_each_file [test] :
    description [string] : Recursive each file finds nested files, ignoring ext case and hidden folders.
    on_test [script] :
      tell ^^.make_tree to run
      put 0 into ^^.count
      tell ^^.files to run
      eval ^^.count = 3
      assert "expected top.md, a/x.md and a/deep/Y.MD"
      tell ^^.remove_tree to run

  wildcard_in_folder [test] :
    description [string] : A ** wildcard in the folder walks the tree too.
    on_test [script] :
      tell ^^.make_tree to run
      put 0 into ^^.count
      tell ^^.wild to run
      eval ^^.count = 3
      assert "expected the same 3 files as recursive"
      tell ^^.remove_tree to run

  files_only_by_default [test] :
    description [string] : Each file without ext lists files, not folders.
    on_test [script] :
      tell ^^.make_tree to run
      put 0 into ^^.count
      tell ^^.top to run
      eval ^^.count = 2
      assert "expected top.md and notes.txt, but not the folder a"
      tell ^^.remove_tree to run

  recursive_each_dir [test] :
    description [string] : Recursive each dir lists every folder in the tree, skipping hidden ones.
    on_test [script] :
      tell ^^.make_tree to run
      put 0 into ^^.count
      tell ^^.dirs to run
      eval ^^.count = 2
      assert "expected a and a/deep"
      tell ^^.remove_tree to run
