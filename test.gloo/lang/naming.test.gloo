#
# Object naming tests
#

tests.lang.naming [can] :

  Alpha [string] : mixed case

  1 [string] : numeric name

  string [string] : a type keyword as a name
  put [string] : a verb keyword as a name

  # A fixture with a deliberately nameless object, loaded inside its
  # test so the syntax error it reports belongs to that test.
  nameless_file [file] :

  # A fixture that declares one name twice, loaded inside its tests so
  # the warning about the ignored value belongs to them.
  dup_file [file] :

  # Scratch files live in the gloo tmp folder ($.gloo_tmp).
  on_load [script] :
    put $.gloo_tmp '/gloo_naming_test.gloo' into ^.nameless_file
    put $.gloo_tmp '/gloo_naming_dup_test.gloo' into ^.dup_file

  dup_src [text] : BEGIN
dup_fixture [container] :
  dup [string] : first
  dup [string] : second
  box [container] :
    x [string] : ex
  box [container] :
    y [string] : why
END

  nameless_src [text] : BEGIN
naming_fixture [container] :
  [string] : no name given
END

  first_of_a_duplicate_name_wins [test] :
    description [string] : a second declaration of a name is the same object; the first value wins.
    expect_errors [bool] : true
    on_test [script] :
      tell ^^.dup_file to write ( ^^.dup_src )
      load ( ^^.dup_file )
      eval dup_fixture.dup = 'first'
      assert "expected the first value to win"

      tell dup_fixture to count
      eval it = 2
      assert "expected one 'dup' and one 'box', not four objects"

      tell dup_fixture to unload
      tell ^^.dup_file to delete

  a_container_declared_twice_merges [test] :
    description [string] : a container declared twice is one container with the children of both.
    expect_errors [bool] : true
    on_test [script] :
      tell ^^.dup_file to write ( ^^.dup_src )
      load ( ^^.dup_file )
      tell dup_fixture.box to count
      eval it = 2
      assert "expected x and y in the one box"

      eval dup_fixture.box.y = 'why'
      assert "expected the second declaration's child to be there"

      tell dup_fixture to unload
      tell ^^.dup_file to delete

  path_lookup_is_case_insensitive [test] :
    description [string] : a pathname segment matches a name regardless of case.
    on_test [script] :
      eval tests.lang.naming.alpha = 'mixed case'
      assert "expected lower-case lookup to find 'Alpha'"

      eval tests.lang.naming.ALPHA = 'mixed case'
      assert "expected upper-case lookup to find 'Alpha'"

  numeric_and_keyword_names [test] :
    description [string] : digits and reserved-looking words are valid object names.
    on_test [script] :
      eval tests.lang.naming.1 = 'numeric name'
      assert "expected a numeric name to work"

      eval ^^.string = 'a type keyword as a name'
      assert "expected a type keyword to be usable as a name"

      eval ^^.put = 'a verb keyword as a name'
      assert "expected a verb keyword to be usable as a name"

  declaration_with_no_name_gets_a_placeholder [test] :
    description [string] : a declaration with no name loads under the placeholder name unnamed_1.
    expect_errors [bool] : true
    on_test [script] :
      tell ^^.nameless_file to write ( ^^.nameless_src )
      load ( ^^.nameless_file )
      eval naming_fixture.unnamed_1 = 'no name given'
      assert "expected the nameless object to be reached as unnamed_1"

      tell naming_fixture to unload
      tell ^^.nameless_file to delete

