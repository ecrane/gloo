#
# Declaration syntax tests
#

tests.lang.declaration [can] :

  # A fixture deliberately missing the ']' after its type, loaded inside
  # its test so the syntax error it reports belongs to that test.
  # Loading reads the type as 'int' anyway.
  unclosed_file [file] :

  # Scratch files live in the gloo tmp folder ($.gloo_tmp).
  on_load [script] :
    put $.gloo_tmp '/gloo_declaration_test.gloo' into ^.unclosed_file

  unclosed_src [text] : BEGIN
declaration_fixture [container] :
  unclosed [int : 7
END

  closed_then_colon [int]: 8

  type_missing_its_closing_bracket [test] :
    description [string] : a type missing its ']' is still read as that type, with its value.
    expect_errors [bool] : true
    on_test [script] :
      tell ^^.unclosed_file to write ( ^^.unclosed_src )
      load ( ^^.unclosed_file )
      eval declaration_fixture.unclosed = 7
      assert "expected the value 7"

      put '12' into declaration_fixture.unclosed
      eval declaration_fixture.unclosed = 12
      assert "expected it to still be an integer"

      tell declaration_fixture to unload
      tell ^^.unclosed_file to delete

  closed_type_followed_by_the_colon [test] :
    description [string] : a ']' followed directly by ':' is a normal declaration.
    on_test [script] :
      eval ^^.closed_then_colon = 8
      assert "expected the value 8"

  # A fixture beside this file whose lines mix tabs and spaces, on one
  # line and from line to line: a tab counts as two spaces.
  mixed_indent_path [string] : /fixtures/mixed_indent.gloo
  where [string] :

  a_tab_and_spaces_on_one_line_add_up [test] :
    description [string] : a tab plus two spaces is two levels deep, in either order.
    on_test [script] :
      check ^^ for source_dir
      put it into ^^.where
      load ( ^^.where ^^.mixed_indent_path )
      tell mixed_indent_fixture.a to count
      eval it = 2
      assert "expected x and y under a"
      eval mixed_indent_fixture.b = 3
      assert "expected b beside a"
      tell mixed_indent_fixture to unload

  # Spaces just inside the brackets are allowed.
  spaced_int [ int ] : 5
  spaced_after [int ]: 6
  spaced_text [text ] : BEGIN
one
END

  spaces_inside_the_brackets_are_allowed [test] :
    description [string] : a space just inside a type's brackets doesn't change the type.
    on_test [script] :
      eval ^^.spaced_int = 5
      assert "expected [ int ] to be an integer 5"
      eval ^^.spaced_after + 1 = 7
      assert "expected [int ]: to be an integer 6"
      check ^^.spaced_text for starts_with? ( 'one' )
      assert "expected [text ] to read its block"

