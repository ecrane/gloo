#
# Gloo System tests
#

tests.lang.ops [can] :

  first [string] : Ada
  last [string] : Lovelace
  full [string] :
  count [int] : 3
  five [string] : 5

  confirm_eq_ops [test] :
    description [string] : Confirm equality operations.
    on_test [script] :
      eval 1 = 1
      assert "expected 1 = 1"

      eval 2 = 3
      refute "expected 2 to not equal 3"

      eval "hello" = "hello"
      assert "expected 'hello' = 'hello'"

      eval "hello" = "world"
      refute "expected 'hello' to not equal 'world'"

  confirm_not_eq_ops [test] :
    description [string] : Confirm not equal operations.
    on_test [script] :
      eval 1 != 2
      assert "expected 1 != 2"

      eval 1 != 1
      refute "expected 1 to not equal 1"

      eval "hello" != "world"
      assert "expected 'hello' != 'world'"

      eval "hello" != "hello"
      refute "expected 'hello' to not equal 'hello'"

  confirm_gt_ops [test] :
    description [string] : Confirm greater than operations.
    on_test [script] :
      eval 2 > 1
      assert "expected 2 > 1"

      eval 1 > 2
      refute "expected 1 to not be greater than 2"

      eval 2 > 2
      refute "expected 2 to not be greater than 2"

      eval 3 >= 2
      assert "expected 3 >= 2"

      eval 2 >= 3
      refute "expected 2 to not be greater than or equal to 3"

      eval 2 >= 2
      assert "expected 2 >= 2" 

  confirm_lt_ops [test] :
    description [string] : Confirm less than operations.
    on_test [script] :
      eval 1 < 2
      assert "expected 1 < 2"

      eval 2 < 1
      refute "expected 2 to not be less than 1"

      eval 1 < 1
      refute "expected 1 to not be less than 1"

      eval 1 <= 2
      assert "expected 1 <= 2"

      eval 2 <= 1
      refute "expected 2 to not be less than or equal to 1"

      eval 1 <= 1
      assert "expected 1 <= 1"

  confirm_and_joins [test] :
    description [string] : and joins values, the same as +.
    on_test [script] :
      put ^^.first and ' ' and ^^.last into ^^.full
      eval ^^.full = 'Ada Lovelace'
      assert "expected first and ' ' and last to be 'Ada Lovelace'"

      eval 2 and 3 = 5
      assert "expected 2 and 3 to be 5"

  confirm_join_without_operator [test] :
    description [string] : Values side by side with no operator between them are joined.
    on_test [script] :
      put 'hello ' 'world' into ^^.full
      eval ^^.full = 'hello world'
      assert "expected 'hello ' 'world' to be 'hello world'"

      put ^^.first ' ' ^^.last into ^^.full
      eval ^^.full = 'Ada Lovelace'
      assert "expected first ' ' last to be 'Ada Lovelace'"

      put 'a' 'b' + 'c' and 'd' into ^^.full
      eval ^^.full = 'abcd'
      assert "expected no operator, + and and to mix"


  confirm_integer_and_decimal_math [test] :
    description [string] : An integer and a decimal give a decimal, whichever side each is on.
    on_test [script] :
      eval 1 + 2.5 = 3.5
      assert "expected 1 + 2.5 to be 3.5"

      eval 1 - 0.5 = 0.5
      assert "expected 1 - 0.5 to be 0.5"

      eval 3 * 1.5 = 4.5
      assert "expected 3 * 1.5 to be 4.5"

      eval 7 / 2.0 = 3.5
      assert "expected 7 / 2.0 to be 3.5"

      eval 2.5 + 1 = 3.5
      assert "expected 2.5 + 1 to be 3.5"

  confirm_two_integers_stay_integers [test] :
    description [string] : An integer with an integer gives an integer.
    on_test [script] :
      eval 7 / 2 = 3
      assert "expected 7 / 2 to be 3"

  confirm_integer_and_decimal_compare [test] :
    description [string] : An integer on the left is compared with a decimal as a decimal.
    on_test [script] :
      eval 1 = 1.9
      refute "expected 1 to not equal 1.9"

      eval 1 != 1.9
      assert "expected 1 != 1.9"

      eval 1 < 1.5
      assert "expected 1 < 1.5"

      eval 2 > 1.5
      assert "expected 2 > 1.5"

      eval 1 <= 0.5
      refute "expected 1 to not be less than or equal to 0.5"

      eval 1 >= 1.5
      refute "expected 1 to not be greater than or equal to 1.5"

  confirm_text_less_than [test] :
    description [string] : Text is compared in dictionary order with < and <=.
    on_test [script] :
      eval 'abc' < 'abd'
      assert "expected 'abc' < 'abd'"

      eval 'B' < 'a'
      refute "expected 'B' to not be less than 'a'"

      eval 'A' < 'a'
      assert "expected 'A' < 'a' (capital first on a tie)"

      eval 'apple' < 'Banana'
      assert "expected 'apple' < 'Banana'"

      eval 'x' <= 'x'
      assert "expected 'x' <= 'x'"

      eval 'abd' <= 'abc'
      refute "expected 'abd' to not be less than or equal to 'abc'"

  confirm_text_greater_than [test] :
    description [string] : Text is compared in dictionary order with > and >=.
    on_test [script] :
      eval 'abd' > 'abc'
      assert "expected 'abd' > 'abc'"

      eval 'b' > 'A'
      assert "expected 'b' > 'A'"

      eval 'x' > 'x'
      refute "expected 'x' to not be greater than 'x'"

      eval 'x' >= 'x'
      assert "expected 'x' >= 'x'"

      eval 'A' >= 'a'
      refute "expected 'A' to not be greater than or equal to 'a'"

  confirm_text_equal_stays_exact [test] :
    description [string] : = still tells capitals apart.
    on_test [script] :
      eval 'x' = 'X'
      refute "expected 'x' to not equal 'X'"

  confirm_number_and_text_join [test] :
    description [string] : + with text on either side joins, as text.
    on_test [script] :
      put ^^.count ' items' into ^^.full
      eval ^^.full = '3 items'
      assert "expected count ' items' to be '3 items'"

      put ^^.count and ' items' into ^^.full
      eval ^^.full = '3 items'
      assert "expected count and ' items' to be '3 items'"

      eval 5 + '5' = '55'
      assert "expected 5 + '5' to be '55'"

  confirm_text_as_number_in_math [test] :
    description [string] : - * and / use text as a number.
    on_test [script] :
      eval 10 - ^^.five = 5
      assert "expected 10 - five to be 5"

      eval '3' * 2 = 6
      assert "expected '3' * 2 to be 6"

      eval '7.0' / 2 = 3.5
      assert "expected '7.0' / 2 to be 3.5"

  confirm_text_not_a_number_is_zero [test] :
    description [string] : Text that isn't a number is 0 in math, with a warning.
    expect_errors [bool] : true
    on_test [script] :
      eval 1 - 'a' = 1
      assert "expected 1 - 'a' to be 1"

  confirm_number_and_text_compare [test] :
    description [string] : A number and text that holds a number compare as numbers.
    on_test [script] :
      eval '5' < 10
      assert "expected '5' < 10"

      eval 3 = '3'
      assert "expected 3 = '3'"

      eval ^^.five = 5
      assert "expected five = 5"

      eval 3 = 'abc'
      refute "expected 3 to not equal 'abc'"

  confirm_grouping [test] :
    description [string] : A group in parentheses is worked out first.
    on_test [script] :
      eval 2 * ( 3 + 4 ) = 14
      assert "expected 2 * ( 3 + 4 ) to be 14"

      eval ( 1 + 2 ) * 3 = 9
      assert "expected ( 1 + 2 ) * 3 to be 9"

      eval ( 3 + 4 )
      eval it = 7
      assert "expected ( 3 + 4 ) to be 7"

  confirm_groups_nest [test] :
    description [string] : Groups nest to any depth.
    on_test [script] :
      eval 2 * ( 3 * ( 1 + 1 ) ) = 12
      assert "expected 2 * ( 3 * ( 1 + 1 ) ) to be 12"

      eval ((1 + 2) * (3 + 4)) = 21
      assert "expected ((1 + 2) * (3 + 4)) to be 21"

  confirm_no_precedence [test] :
    description [string] : Without a group, still strictly left to right.
    on_test [script] :
      eval 2 + 3 * 4 = 20
      assert "expected 2 + 3 * 4 to be 20"

      eval 2 + ( 3 * 4 ) = 14
      assert "expected 2 + ( 3 * 4 ) to be 14"

  confirm_quoted_parens_are_text [test] :
    description [string] : Parentheses inside quotes are text.
    on_test [script] :
      put 'a (b)' into ^^.full
      eval ^^.full = 'a (b)'
      assert "expected 'a (b)' to stay as text"

  confirm_grouping_in_put_and_if [test] :
    description [string] : Groups work in put and in an if's condition and then part.
    on_test [script] :
      put ( 1 + 2 ) * ^^.count into ^^.full
      eval ^^.full = '9'
      assert "expected ( 1 + 2 ) * count to be 9"

      if ( ^^.count = 3 ) then put 'yes' into ^^.full
      eval ^^.full = 'yes'
      assert "expected a group in the condition"

      if true then put 2 * ( 1 + 1 ) into ^^.full
      eval ^^.full = '4'
      assert "expected a group in the then part"
