#
# 'it' tests
#
# 'it' holds the result of the last statement that produced one.
#

tests.lang.it [can] :

  n [int] : 5
  r [string] :

  set_by_the_previous_statement [test] :
    description [string] : show, eval, tell and put all leave their result in it.
    on_test [script] :
      show 3 + 4
      eval it = 7
      assert "expected show to leave the evaluated value in it"

      eval 10 * 2
      eval it = 20
      assert "expected eval to leave its result in it"

      put 'hello' into ^^.r
      eval it = 'hello'
      assert "expected put to leave the stored value in it"

      put 5 into ^^.n
      tell ^^.n to inc
      eval it = 6
      assert "expected tell to leave the message result in it"

  persists_across_statements_that_produce_nothing [test] :
    description [string] : statements like a bare show or list leave it untouched.
    on_test [script] :
      eval 42
      show
      list ^^.n
      eval it = 42
      assert "expected it to survive statements that don't produce a result"

#
# it is a read-only result value, not an object: it can be read, but
# nothing can target it.
#

tests.lang.it_read_only [can] :

  err_fired [bool] : false
  s [string] :

  on_error [script] :
    put true into ^.err_fired

  error_data [can] :
    message [string] :
    backtrace [string] :
    kind [string] :
    location [string] :

  message_to_it_is_an_error [test] :
    description [string] : Sending it a message reports an error that says what to do instead.
    on_test [script] :
      put false into ^^.err_fired
      eval 'abc'
      check it for starts_with? ( 'a' )
      eval ^^.err_fired = true
      assert "expected check it for ... to be an error"

      eval ^^.error_data.message = "it isn't an object and can't be sent messages; put it into an object first (put it into x)."
      assert "expected the error to say to put it into an object first"

  put_into_it_is_an_error [test] :
    description [string] : Putting a value into it is an error.
    on_test [script] :
      put false into ^^.err_fired
      put 'x' into it
      eval ^^.err_fired = true
      assert "expected put into it to be an error"

  put_it_into_an_object_works [test] :
    description [string] : The workaround: put it into an object, then send that object the message.
    on_test [script] :
      put false into ^^.err_fired
      eval 'abc'
      put it into ^^.s
      check ^^.s for starts_with? ( 'a' )
      assert "expected the message to work on the object"

      eval ^^.err_fired = false
      assert "expected no error"

#
# The it rule: a command that works out a value puts it in it; when
# something goes wrong, it is false.
#

tests.lang.it_rule [can] :

  err_fired [bool] : false
  s [string] :
  kept [string] : keep me

  on_error [script] :
    put true into ^.err_fired

  failed_put_sets_it_false [test] :
    description [string] : A put whose value can't be worked out sets it to false and keeps the target.
    on_test [script] :
      put false into ^^.err_fired
      eval 'before'
      put ^^.no_such_value into ^^.kept
      eval it = false
      assert "expected it to be false after a failed put"

      eval ^^.kept = 'keep me'
      assert "expected the target to keep its value"

      eval ^^.err_fired = true
      assert "expected the failed put to be an error"

  put_into_missing_object_sets_it_false [test] :
    description [string] : A put into an object that doesn't exist sets it to false.
    on_test [script] :
      eval 'before'
      put 'x' into ^^.no_such_target
      eval it = false
      assert "expected it to be false"

  value_messages_set_it [test] :
    description [string] : A message that changes its own value also puts the new value in it.
    on_test [script] :
      put '  padded  ' into ^^.s
      tell ^^.s to trim
      eval it = 'padded'
      assert "expected trim to put the trimmed string in it"

      put 'a b' into ^^.s
      tell ^^.s to format_for_html
      eval it = 'a b'
      assert "expected format_for_html to put the result in it"

  failed_function_sets_it_false [test] :
    description [string] : A function whose on_invoke fails sets it to false.
    on_test [script] :
      eval 'before'
      invoke ^^.failing
      eval it = false
      assert "expected it to be false after a failed invoke"

  failing [ƒ] :
    params [can] :
    on_invoke [script] :
      put 1 into no.such.object
    result [int] :
