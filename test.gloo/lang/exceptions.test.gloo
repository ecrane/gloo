#
# Exception handling tests (on_exception / throw)
#

tests.lang.exceptions [can] :

  exc_fired [bool] : false
  err_fired [bool] : false

  on_exception [script] :
    put true into ^.exc_fired

  on_error [script] :
    put true into ^.err_fired

  exception_data [can] :
    message [string] :
    backtrace [string] :

  error_data [can] :
    message [string] :
    backtrace [string] :
    kind [string] :
    location [string] :

  confirm_throw_fires_on_exception [test] :
    description [string] : Confirm throw fires on_exception and populates exception_data, but does not fire on_error.
    on_test [script] :
      put false into ^^.exc_fired
      put false into ^^.err_fired

      throw "test message"

      eval ^^.exc_fired = true
      assert "expected on_exception to have fired"

      eval ^^.err_fired = false
      assert "expected on_error to NOT have fired for a thrown exception"

      eval ^^.exception_data.message = "test message"
      assert "expected exception_data.message to be populated"

  confirm_execution_continues_after_throw [test] :
    description [string] : Confirm execution continues with the next line after a throw.
    on_test [script] :
      throw "boom"
      eval 2 + 2
      eval it = 4
      assert "expected execution to continue after throw"

  confirm_on_error_still_works [test] :
    description [string] : Confirm on_error still fires for a genuine gloo-level error, independent of on_exception.
    on_test [script] :
      put false into ^^.exc_fired
      put false into ^^.err_fired

      tell no_such_object_anywhere to run

      eval ^^.err_fired = true
      assert "expected on_error to have fired for a bad path"

      eval ^^.exc_fired = false
      assert "expected on_exception to NOT have fired for a gloo-level error"

  confirm_missing_value_fires_on_error [test] :
    description [string] : Using a missing object as a value is a runtime error, but asking whether it exists is not.
    on_test [script] :
      put false into ^^.err_fired
      exists? instance ^^.no_such_value
      eval ^^.err_fired = false
      assert "expected exists? on a missing object to not fire on_error"

      show ^^.no_such_value
      eval ^^.err_fired = true
      assert "expected using a missing object as a value to fire on_error"

      eval ^^.error_data.message = "Object '^^.no_such_value' was not found."
      assert "expected error_data.message to name the missing object"

  kept [string] : keep me

  confirm_put_of_missing_value_keeps_target [test] :
    description [string] : A put whose value uses a missing object leaves the target unchanged.
    on_test [script] :
      put 'keep me' into ^^.kept
      put ^^.no_such_value into ^^.kept
      eval ^^.kept = 'keep me'
      assert "expected the target to keep its value"

  confirm_error_kind [test] :
    description [string] : error_data.kind says whether the command couldn't be understood (syntax) or couldn't be done (runtime).
    on_test [script] :
      nosuchverb
      eval ^^.error_data.kind = 'syntax'
      assert "expected an unknown verb to be a syntax error"

      show ^^.no_such_value
      eval ^^.error_data.kind = 'runtime'
      assert "expected a missing object to be a runtime error"

  confirm_error_location [test] :
    description [string] : error_data.location names the script and line that failed.
    on_test [script] :
      show 1
      show ^^.no_such_value
      eval ^^.error_data.location = 'tests.lang.exceptions.confirm_error_location.on_test, line 2'
      assert "expected the location of the failed line"

  num [int] : 5

  confirm_bad_value_is_a_warning [test] :
    description [string] : A value that isn't really of its type is a warning, not an error; the best guess is used.
    on_test [script] :
      put false into ^^.err_fired
      put 'x' into ^^.num
      eval ^^.err_fired = false
      assert "expected a bad value to not fire on_error"

      eval ^^.num = 0
      assert "expected the best guess, 0"

