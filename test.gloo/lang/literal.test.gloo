#
# Literal value tests
#

tests.lang.literal [can] :

  s [string] :
  i [integer] :
  d [decimal] :
  b [boolean] :

  string_quote_styles [test] :
    description [string] : single and double quotes both make a string; the other quote can appear inside.
    on_test [script] :
      put 'single quoted' into ^^.s
      eval ^^.s = 'single quoted'
      assert "expected single quotes to work"

      put "double quoted" into ^^.s
      eval ^^.s = 'double quoted'
      assert "expected double quotes to work"

      put "you're fine" into ^^.s
      eval ^^.s = "you're fine"
      assert "expected an apostrophe inside double quotes to be literal"

  number_literals [test] :
    description [string] : integer and decimal literals, including negatives.
    on_test [script] :
      put -5 into ^^.i
      eval ^^.i = -5
      assert "expected a negative integer literal"

      put 3.14159 into ^^.d
      eval ^^.d = 3.14159
      assert "expected a decimal literal"

      put -2.5 into ^^.d
      eval ^^.d = -2.5
      assert "expected a negative decimal literal"

  boolean_literals_are_case_insensitive [test] :
    description [string] : TRUE, true, False, FALSE all parse.
    on_test [script] :
      put TRUE into ^^.b
      eval ^^.b = true
      assert "expected TRUE to parse"

      put true into ^^.b
      eval ^^.b = true
      assert "expected true to parse"

      put False into ^^.b
      eval ^^.b = false
      assert "expected False to parse"

      put FALSE into ^^.b
      eval ^^.b = false
      assert "expected FALSE to parse"

  decimal_spellings [test] :
    description [string] : trailing zeros, a leading dot, an exponent and a tiny value are all decimals.
    on_test [script] :
      eval 2.50 * 2
      put it into ^^.d
      eval ^^.d = 5.0
      assert "expected 2.50 to be a decimal"

      eval .5 + 0
      put it into ^^.d
      eval ^^.d = 0.5
      assert "expected .5 to be a decimal"

      eval 1.0e3 + 0
      put it into ^^.d
      eval ^^.d = 1000.0
      assert "expected 1.0e3 to be a decimal"

      eval 0.0000001 * 10000000
      put it into ^^.d
      eval ^^.d > 0.99
      assert "expected 0.0000001 to be a decimal"

  integer_spellings [test] :
    description [string] : leading zeros and a leading plus are integers; 007 is 7, not octal.
    on_test [script] :
      eval 007 + 1
      put it into ^^.i
      eval ^^.i = 8
      assert "expected 007 to be 7"

      eval +5 + 0
      put it into ^^.i
      eval ^^.i = 5
      assert "expected +5 to be 5"

  decimal_at_load [test] :
    description [string] : a typed decimal written with trailing zeros loads without a warning.
    on_test [script] :
      put '2.50' into ^^.d
      eval ^^.d = 2.5
      assert "expected '2.50' to go into a decimal as 2.5"
